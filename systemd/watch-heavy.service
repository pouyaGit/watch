[Unit]
Description=Watch heavy worker (serialized brute -> crawl -> param, 24/7)
After=network-online.target docker.service
Wants=network-online.target

[Service]
# One always-on worker that time-slices the three heavy lanes one at a time
# (see watch_heavy_worker.py). Replaces the standalone watch-brute.service and
# the weekly watch-crawl*/watch-param-discovery timers.
Type=simple
User=root
WorkingDirectory=/opt/watch
# Resource caps live in watch-heavy.slice (CPUQuota=60%, MemoryMax=3G,
# IOWeight=20) so the heavy work never starves the 12h pipeline or the API.
Slice=watch-heavy.slice
Environment="PATH=/opt/watch/venv/bin:/usr/local/go/bin:/root/go/bin:/usr/local/bin:/usr/bin:/bin"
Environment=PYTHONUNBUFFERED=1
# Per-lane time slice (applies to ALL lanes: brute, crawl, param, nuclei). 45 min
# gives the brute lane room so a big domain's static+dynamic finishes instead of
# being hard-killed at the old 20m; crawl/param/nuclei just get longer, resumable
# slices. Full cycle ~3h when every lane has work.
Environment=WATCH_HEAVY_LANE_MINUTES=45
# Cap static-brute candidates per domain so one domain's static+dynamic fits a
# lane slice (dell's full ~13M static was ~26 min, overshooting the 20m lane and
# getting hard-killed every visit). shuf-sampling (not head) keeps coverage
# rotating across visits. ~4M ≈ 8 min of puredns; raise if lane minutes grow.
Environment=WATCH_STATIC_MAX_CANDIDATES=4000000
# Send brute-lane progress banners to Telegram too (per-domain "Now bruteforcing
# ... Candidates/ETA" + results), so the operator sees brute activity alongside
# crawl/param -- not just the quiet new-findings + heartbeat. Set to 0 to mute.
Environment=WATCH_BRUTE_VERBOSE=1
# Tunables: WATCH_HEAVY_LANE_MINUTES, WATCH_HEAVY_IDLE_SLEEP, WATCH_HEAVY_LANES,
# and the per-lane knobs (WATCH_BRUTE_*, WATCH_STATIC_MAX_CANDIDATES, X8_WORDLIST).
# Default lanes: brute,crawl,param,nuclei. secret and ffuf are opt-in: add them to
# WATCH_HEAVY_LANES to enable them.
# Crawl lane (gau is merged into it, no separate lane): GAU_ENABLED, GAU_MAX_SEEDS,
# GAU_TIMEOUT (seconds, clamped to the lane budget).
# Nuclei lane: NUCLEI_* (batch size, rate, timeouts, tag set).
# Secret lane: SECRET_BATCH, SECRET_MAX_BYTES, SECRET_DELAY_MS, SECRET_RESCAN_DAYS,
# SECRET_TIMEOUT. Stores redacted matches only.
# ffuf lane: FFUF_BATCH_HOSTS, FFUF_HOST_TIMEOUT, FFUF_RATE, FFUF_THREADS,
# FFUF_RESCAN_DAYS, FFUF_WORDLIST.
# Health and digest (separate timers): WATCH_HEALTH_UNITS, WATCH_HEALTH_URLS,
# WATCH_HEALTH_TIMEOUT, WATCH_HEALTH_STATE, WATCH_DIGEST_WINDOW_HOURS, WATCH_DIGEST_STATE.
# Retention (watch-maintenance.timer): URLS_RETENTION_MONTHS, CHANGE_EVENTS_MAX,
# MAINTENANCE_BATCH.
ExecStart=/opt/watch/venv/bin/python3 /opt/watch/watch_heavy_worker.py
Restart=always
RestartSec=30
KillMode=control-group
TimeoutStopSec=120s

[Install]
WantedBy=multi-user.target
