[Unit]
Description=Resource Limits for Watch Heavy Jobs

[Slice]
# CPUQuota is a ceiling in units of one core (300% = 3 of the 6 vCPUs), not a reservation.
CPUQuota=300%
# Lower weight than the API and watch.service (default 100), so they win under contention.
CPUWeight=50

# Measured peak ~1.2 GB; leave headroom for nuclei/brute subprocesses.
MemoryHigh=4G
MemoryMax=5G

# Keep disk I/O low priority.
IOWeight=20
