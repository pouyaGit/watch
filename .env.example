# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Binary Paths
HTTPX_BIN=/path/to/httpx

# Project Directories
WATCH_DIR=/opt/watch/

# Dashboard login (port 5000)
DASHBOARD_USER=admin
DASHBOARD_PASS_HASH=            # set via scripts/set_dashboard_password.py --write
DASHBOARD_SECRET=               # openssl rand -hex 32
DASHBOARD_SESSION_TTL=43200
# API_KEY stays for programmatic /api access (optional)
